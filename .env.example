# ---------------------------------------------------------------------------------------------
# Docversity — environment template
#
#   cp .env.example .env
#
# The values below are DEVELOPMENT-ONLY defaults that match docker-compose.yml. They are not
# secrets and must never be used outside a local machine. Never commit a real .env file.
#
# Every app validates its variables at startup and refuses to start if a required one is missing
# or malformed (see packages/validation/src/env).
# ---------------------------------------------------------------------------------------------

NODE_ENV=development
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log

# --- Public URLs -----------------------------------------------------------------------------
# Browser-facing base URL of the Next.js app.
WEB_URL=http://localhost:3000
# Browser-facing base URL of the NestJS API.
API_URL=http://localhost:4000

# --- API (apps/api) --------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Serve Swagger UI at /api/docs. Keep disabled in production unless access is restricted.
SWAGGER_ENABLED=true
# Per-dependency timeout for GET /health checks.
HEALTH_CHECK_TIMEOUT_MS=2000

# --- Web (apps/web) --------------------------------------------------------------------------
# URL the Next.js SERVER uses to reach the API (server-to-server; may differ from API_URL in
# containers). Never exposed to the browser.
API_INTERNAL_URL=http://127.0.0.1:4000
# false (default): the web server is the edge and DROPS client-supplied X-Forwarded-For/X-Real-IP
# before proxying /api/v1 to the API (they would be spoofable). true: a trusted load balancer in
# front of the web server appends the real client IP, so the chain is passed through.
WEB_BEHIND_TRUSTED_PROXY=false

# --- PostgreSQL ------------------------------------------------------------------------------
# Used by docker-compose.yml to initialise the container.
POSTGRES_USER=docversity
POSTGRES_PASSWORD=docversity_dev_password
POSTGRES_DB=docversity
POSTGRES_HOST_PORT=55432
# Used by Prisma / the API.
DATABASE_URL=postgresql://docversity:docversity_dev_password@127.0.0.1:55432/docversity?schema=public

# --- Redis -----------------------------------------------------------------------------------
REDIS_PASSWORD=docversity_dev_redis
REDIS_HOST_PORT=56379
REDIS_URL=redis://:docversity_dev_redis@127.0.0.1:56379/0

# --- Object storage (S3-compatible) ----------------------------------------------------------
# Local: MinIO from docker-compose. Production: Cloudflare R2 or AWS S3 — change ONLY these values:
#   R2:     S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#           S3_FORCE_PATH_STYLE=false (R2 supports both styles)
#   AWS S3: leave S3_ENDPOINT unset, S3_REGION=<aws-region>, S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=docversity-local
# Least-privilege application credentials (created by the minio-init service), NOT the root user.
S3_ACCESS_KEY=docversity_app
S3_SECRET_KEY=docversity_dev_app_secret
S3_FORCE_PATH_STYLE=true

# MinIO server root account — used only by docker-compose (server + minio-init), never by the apps.
MINIO_ROOT_USER=docversity_admin
MINIO_ROOT_PASSWORD=docversity_dev_minio_admin
MINIO_API_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001

# --- Worker (apps/worker) --------------------------------------------------------------------
WORKER_CONCURRENCY=2
# Import steps processed in parallel (each parses a whole workbook in memory).
IMPORT_CONCURRENCY=1
# BullMQ key prefix in Redis — API (producer) and worker (consumer) must use the same value.
QUEUE_PREFIX=bull

# --- Spreadsheet imports (apps/api + apps/worker) --------------------------------------------
# Safe development defaults; see docs/architecture/imports.md for production tuning.
IMPORT_MAX_FILE_MB=10
IMPORT_MAX_UNCOMPRESSED_MB=100
IMPORT_MAX_ROWS=10000
IMPORT_MAX_COLUMNS=50
IMPORT_BATCH_SIZE=250

# --- Authentication & sessions (apps/api) ----------------------------------------------------
# HMAC key for hashing emails/IPs/tokens before they reach Redis, logs or the audit trail.
# >= 32 characters. The API refuses to start in production with this development placeholder.
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef
# Secure cookies. false is accepted ONLY when WEB_URL is localhost; production requires true.
COOKIE_SECURE=false
# Idle timeout (30 min) and absolute lifetime (12 h) of a staff session.
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
# Student portal activation codes (Phase 6): validity and wrong-code limit per open code.
STUDENT_ACTIVATION_CODE_TTL_DAYS=30
STUDENT_ACTIVATION_MAX_FAILED_ATTEMPTS=10
# Which proxies may set X-Forwarded-For for the API. Never "true".
# Locally the web server is the edge and strips client-supplied forwarding headers (see
# WEB_BEHIND_TRUSTED_PROXY), so nothing is trusted. Production behind a load balancer: list the web
# server's and load balancer's IPs/CIDRs (see docs/architecture/authentication.md).
TRUST_PROXY=false
# Login throttling (per window): per account+IP, per account, per IP.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT_IP=5
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=20
LOGIN_MAX_ATTEMPTS_PER_IP=100
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800

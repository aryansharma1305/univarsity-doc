{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "CI",
    "WEB_URL",
    "API_URL",
    "API_HOST",
    "API_PORT",
    "API_INTERNAL_URL",
    "CORS_ORIGINS",
    "SWAGGER_ENABLED",
    "HEALTH_CHECK_TIMEOUT_MS",
    "DATABASE_URL",
    "REDIS_URL",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_FORCE_PATH_STYLE",
    "WORKER_CONCURRENCY",
    "PLAYWRIGHT_BROWSERS_PATH",
    "WEB_BEHIND_TRUSTED_PROXY",
    "TRUST_PROXY",
    "SESSION_SECRET",
    "COOKIE_SECURE",
    "SESSION_IDLE_TIMEOUT_SECONDS",
    "SESSION_ABSOLUTE_TIMEOUT_SECONDS",
    "REDIS_KEY_PREFIX",
    "LOGIN_RATE_LIMIT_WINDOW_SECONDS",
    "LOGIN_MAX_ATTEMPTS_PER_ACCOUNT_IP",
    "LOGIN_MAX_ATTEMPTS_PER_ACCOUNT",
    "LOGIN_MAX_ATTEMPTS_PER_IP",
    "PASSWORD_RESET_TOKEN_TTL_SECONDS",
    "ADMIN_EMAIL",
    "ADMIN_DISPLAY_NAME",
    "ADMIN_PASSWORD",
    "E2E_BASE_DATABASE_URL"
  ],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/**", "prisma.config.ts", "package.json"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": [
        "build",
        "@docversity/api#build",
        "@docversity/worker#build",
        "@docversity/database#build",
        "@docversity/imports#build"
      ],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}

{
	admin off
	skip_install_trust
	auto_https disable_redirects
}
# Defines the reviewer_gate snippet (generated by staging.py review-init; never committed).
import /etc/caddy/review-gate.caddy
https://localhost {
	tls internal
	import /etc/caddy/review-site.caddy
}
# Container-internal readiness for the Compose healthcheck only; this port is never published.
http://:8081 {
	handle /health {
		reverse_proxy api:4000
	}
	respond 404
}

# Production-mode SYNTHETIC review worker; no session-signing or bootstrap/owner credentials.
# Reference only; init-local.py generates the private worker_runtime file.
NODE_ENV=production
LOG_LEVEL=log
DATABASE_URL=
REDIS_URL=
QUEUE_PREFIX=staging
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=docversity-staging
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
WORKER_CONCURRENCY=1
IMPORT_CONCURRENCY=1

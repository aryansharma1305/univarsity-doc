# Production-mode SYNTHETIC review stack reference; not an active environment file.
# init-local.py generates private runtime files. Empty credentials intentionally fail validation.
NODE_ENV=production
LOG_LEVEL=log
API_HOST=0.0.0.0
API_PORT=4000
WEB_URL=https://review.example.invalid
CORS_ORIGINS=https://review.example.invalid
SWAGGER_ENABLED=false
TRUST_PROXY=2
COOKIE_SECURE=true
SESSION_SECRET=
STAFF_MFA_ENCRYPTION_KEY=
STAFF_MFA_ENFORCED=false
# Razorpay stays off here; test mode needs runtime secrets (see .env.example), never this file.
PAYMENTS_RAZORPAY_MODE=off
MFA_RATE_LIMIT_WINDOW_SECONDS=900
MFA_MAX_ATTEMPTS_PER_ACCOUNT_IP=5
MFA_MAX_ATTEMPTS_PER_ACCOUNT=5
MFA_MAX_ATTEMPTS_PER_IP=50
MFA_LOCKOUT_THRESHOLD=10
MFA_LOCKOUT_WINDOW_SECONDS=86400
MFA_LOCKOUT_SECONDS=86400
DATABASE_URL=
REDIS_URL=
REDIS_KEY_PREFIX=staging:
QUEUE_PREFIX=staging
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=docversity-staging
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
WORKER_CONCURRENCY=1
IMPORT_CONCURRENCY=1

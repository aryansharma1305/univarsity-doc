# Production-mode SYNTHETIC review stack reference; not an active environment file.
# init-local.py generates private runtime files. Empty credentials intentionally fail validation.
NODE_ENV=production
LOG_LEVEL=log
API_HOST=0.0.0.0
API_PORT=4000
WEB_URL=https://review.example.invalid
CORS_ORIGINS=https://review.example.invalid
SWAGGER_ENABLED=false
TRUST_PROXY=2
COOKIE_SECURE=true
SESSION_SECRET=

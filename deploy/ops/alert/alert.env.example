# /etc/docversity/alert.env (0600 root). Channel is an OPEN DECISION; until then: log.
ALERT_CHANNEL=log
# ALERT_WEBHOOK_URL=https://...
# ALERT_NTFY_URL=https://ntfy.sh/<long-random-topic>
# ALERT_TELEGRAM_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_EMAIL_TO=
# Dead-man's switch (e.g. healthchecks.io check URL): pinged every run; "/fail" appended on problems.
# Detects a dead VPS/timer, which no on-box check can.
# DV_HEARTBEAT_URL=https://hc-ping.com/<uuid>
# Thresholds (per DV_WINDOW, default 10m) — defaults in healthcheck.sh
# DV_API_5XX_MAX=5
# DV_API_ERROR_MAX=5
# DV_429_MAX=30
# DV_CSP_MAX=50
# DV_DISK_MAX_PCT=85
# DV_TLS_MIN_DAYS=21
# DV_BACKUP_MAX_AGE_HOURS=26
# DV_PLAINTEXT_MAX_AGE_HOURS=192
# DV_REPEAT_MINUTES=60

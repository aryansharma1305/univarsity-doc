# Dependencies
node_modules/

# Environment — never commit real values; .env.example is the template
.env
.env.*
!.env.example

# Generated by Next.js on every dev/build
next-env.d.ts

# Build output and caches
dist/
.next/
out/
.turbo/
*.tsbuildinfo
coverage/

# Prisma generated client
packages/database/src/generated/

# Test artefacts
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Local service data (Docker volumes are named volumes; these guard against bind-mount mistakes)
docker/data/
.data/
*.dump
*.sql.gz

# Runtime-generated files that must never enter git.
# Anchored to the repo root so future source folders (e.g. src/modules/imports) are NOT ignored.
/tmp/
/storage/
/generated-pdfs/
/uploaded-files/
*.pdf
!references/**/*.pdf
*.xlsx
*.xls
*.csv
!references/**/*.xlsx
!**/fixtures/**/*.xlsx
!**/fixtures/**/*.csv

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Dependencies
node_modules/

# Environment — never commit real values; .env.example is the template
.env
.env.*
!.env.example

# Generated by Next.js on every dev/build
next-env.d.ts

# Build output and caches
dist/
.next/
out/
.turbo/
*.tsbuildinfo
coverage/

# Prisma generated client
packages/database/src/generated/

# Test artefacts
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Local service data (Docker volumes are named volumes; these guard against bind-mount mistakes)
docker/data/
.data/
*.dump
*.sql.gz

# Runtime-generated files that must never enter git.
# Anchored to the repo root so future source folders (e.g. src/modules/imports) are NOT ignored.
/tmp/
/storage/
/generated-pdfs/
/uploaded-files/
*.pdf
!references/**/*.pdf
# Phase 12C.1: fixed synthetic academic samples (fictional, SAMPLE-watermarked, SHA-256 pinned in code).
!packages/documents/assets/samples/academic/*.pdf
*.xlsx
*.xls
*.csv
!references/**/*.xlsx
!**/fixtures/**/*.xlsx
!**/fixtures/**/*.csv

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Playwright e2e fixtures (random credentials for the disposable e2e database)
.e2e/

# graphify: commit the graph/report, not the local caches and interpreter paths
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_*
graphify-out/20*/

# Reviewed synthetic sample shipped privately by the document package (never real student PDFs)
!packages/documents/assets/samples/training-v1.pdf

# Isolated staging credentials, certificates and backup data
.local/
deploy/scripts/__pycache__/
deploy/render/__pycache__/

{
  "name": "@docversity/documents",
  "version": "0.0.0",
  "private": true,
  "description": "Validated, synthetic-only marksheet templates and PDF renderer.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "@docversity/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "eslint": "9.39.5",
    "pdf2json": "4.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@docversity/validation": "workspace:*",
    "pdfkit": "0.20.2"
  }
}

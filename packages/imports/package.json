{
  "name": "@docversity/imports",
  "version": "0.0.0",
  "private": true,
  "description": "Spreadsheet import engine (Phase 5: students): workbook reading, column mapping, row validation, batched idempotent commit, templates and error reports. Used by the API and the worker.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@docversity/database": "workspace:*",
    "@docversity/storage": "workspace:*",
    "@docversity/types": "workspace:*",
    "@docversity/validation": "workspace:*",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@docversity/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}

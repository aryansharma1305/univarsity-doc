// Docversity core academic schema (Phase 2).
//
// Conventions
// - One university: no tenant/institution columns.
// - Primary keys are UUIDv7 generated by Prisma (time-ordered → index-friendly). Human identifiers
//   (registration number, program/subject codes, certificate number) are separate columns and are
//   never the primary key. Sequential IDs are never used as public verification identifiers.
// - Tables and columns are snake_case in PostgreSQL (@@map / @map); models are PascalCase here.
// - Timestamps are timestamptz(3); calendar dates are date.
// - Marks: NUMERIC(7,2). Credits: NUMERIC(5,2). Grade points / SGPA / CGPA: NUMERIC(5,3).
//   See docs/database/README.md for the rationale.
// - Relations default to RESTRICT. CASCADE is used only inside an aggregate (result → items,
//   import job → rows, user → role links). Every choice is documented in docs/database/README.md.
// - Some invariants cannot be expressed in Prisma and live in the migration SQL instead:
//   CHECK constraints and immutability/consistency triggers (published results, issued
//   certificates, used templates/grading schemes, append-only logs). Prisma's drift check
//   (`pnpm db:check`) ignores them by design, so they never cause false drift.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================================
// Enums
// ============================================================================================

/// Lifecycle of reference/master data. Records are deactivated, never hard-deleted once used.
enum MasterDataStatus {
  ACTIVE
  INACTIVE
}

enum AcademicSessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// Status of a student's registration (enrolment in a program).
enum StudentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
  REVOKED
}

enum GradingSchemeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ExaminationStatus {
  DRAFT
  OPEN
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
}

/// Ordinary examination or re-examination (Phase 9). Free-text `exam_type` stays as the label.
enum ExaminationKind {
  REGULAR
  RE_EXAMINATION
}

/// What a re-exam fee is charged per (Phase 9B). Chosen explicitly by staff; unconfirmed policy.
enum ReExamFeeScope {
  PER_SUBJECT
  PER_APPLICATION
  PER_EXAMINATION_SESSION
}

enum ReExamFeeRuleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ReExamApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

/// Whether a fee could be assessed when the application was submitted (or re-checked).
enum ReExamFeeStatus {
  ASSESSED
  NOT_CONFIGURED
}

/// The eight country/region choices of the re-exam Pay Now section (Phase 9C). EUROPE, CENTRAL_ASIA
/// and OTHERS are region groups, not single countries.
enum PaymentRegion {
  INDIA
  NEPAL
  BANGLADESH
  PAKISTAN
  AFGHANISTAN
  EUROPE
  CENTRAL_ASIA
  OTHERS
}

/// DRAFT (staff only, editable) → APPROVED (visible to students while active and in effect; frozen) →
/// RETIRED (final). DRAFT → RETIRED is allowed.
enum PaymentDestinationStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  MOBILE_WALLET
  OTHER
}

/// Whether a student must attach payment evidence when submitting a transaction reference.
enum PaymentEvidenceRequirement {
  OPTIONAL
  REQUIRED
}

/// AWAITING_PAYMENT → SUBMITTED → VERIFIED | REJECTED; AWAITING_PAYMENT → VOID (region changed before
/// paying). "Not configured" is a derived state (no row). Nothing becomes VERIFIED without staff.
enum ReExamPaymentStatus {
  AWAITING_PAYMENT
  SUBMITTED
  VERIFIED
  REJECTED
  VOID
}

/// Where an obligation's amount came from: the application's assessed fee (same currency), or an
/// explicitly approved per-attempt amount of the destination (another currency). Never a conversion.
enum ReExamPaymentAmountSource {
  FEE_RULE
  DESTINATION_RATE
}

enum ResultPublicationStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  SUPERSEDED
  WITHHELD
}

enum ResultOutcome {
  PASS
  FAIL
  BACKLOG
  WITHHELD
}

enum ResultItemStatus {
  PASS
  FAIL
  ABSENT
  BACKLOG
  WITHHELD
}

enum DocumentType {
  PROVISIONAL
  TRANSCRIPT
  CHARACTER
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PageOrientation {
  PORTRAIT
  LANDSCAPE
}

enum CertificateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  REVOKED
  CANCELLED
  SUPERSEDED
}

enum ImportType {
  STUDENTS
  RESULTS
}

enum ImportStatus {
  UPLOADED
  MAPPING
  VALIDATING
  VALIDATED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  VALID
  WARNING
  ERROR
  IMPORTED
  SKIPPED
}

/// What committing an importable row does (Phase 5).
enum ImportRowAction {
  CREATE
  UPDATE
  SKIP
}

enum VerificationType {
  REGISTRATION
  RESULT
  CERTIFICATE
  QR
}

enum VerificationOutcome {
  VALID
  INVALID
  REVOKED
  CANCELLED
  NOT_FOUND
  WITHHELD
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Student portal account status (Phase 6). LOCKED = temporarily blocked; DISABLED = by staff, with a reason.
enum StudentAccountStatus {
  ACTIVE
  LOCKED
  DISABLED
}

/// How a program's (or curriculum's) academic periods are organised (Phase 7B).
enum AcademicStructure {
  SEMESTER_WISE
  YEAR_WISE
}

enum DurationUnit {
  MONTHS
  YEARS
}

/// Curriculum version lifecycle (Phase 7B). Only DRAFT versions can be edited; ACTIVE ones can be
/// assigned to registrations; ARCHIVED ones stay readable for historical records.
enum CurriculumStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Theory / practical classification of a subject (catalogue default) or of its assignment.
enum SubjectCategory {
  THEORY
  PRACTICAL
  COMBINED
}

/// Kind of historical document uploaded by staff (Phase 8). Not a Docversity-issued credential.
enum HistoricalDocumentType {
  DEGREE_CERTIFICATE
  DIPLOMA_CERTIFICATE
  PROVISIONAL_CERTIFICATE
  MARKSHEET
  TRANSCRIPT
  MIGRATION_CERTIFICATE
  CHARACTER_CERTIFICATE
  OTHER
}

/// Student visibility lifecycle of a historical document. Nothing is ever deleted.
enum HistoricalDocumentStatus {
  /// Uploaded by staff; not visible to the student.
  DRAFT
  /// Visible to its student in /student/documents.
  PUBLISHED
  /// Hidden from the student with a recorded reason (may be published again).
  WITHDRAWN
  /// Replaced by a newer published document; kept for history.
  SUPERSEDED
}

/// Official authenticity review — independent of student visibility. Never "cryptographically verified".
enum DocumentAuthenticity {
  UNVERIFIED
  CONFIRMED_AGAINST_RECORDS
  DISPUTED
}

/// Where a historical document came from.
enum DocumentProvenance {
  UNIVERSITY_ARCHIVE
  LEGACY_WORDPRESS
  STUDENT_PROVIDED_COPY
  OTHER
}

/// Kinds of embedded image metadata detected at upload (Phase 8 hardening). Values are never stored.
enum EmbeddedMetadataCategory {
  LOCATION
  DEVICE
  PERSON
  TEXT
  OTHER
}

/// Lifecycle of a student's profile change request (Phase 7). Only PENDING requests change state.
enum ProfileChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ============================================================================================
// Organisation & calendar
// ============================================================================================

model Department {
  id        String           @id @default(uuid(7)) @db.Uuid
  code      String           @unique @db.VarChar(32)
  name      String           @db.VarChar(200)
  status    MasterDataStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  programs      Program[]
  registrations StudentRegistration[]

  @@map("departments")
}

model Program {
  id                String             @id @default(uuid(7)) @db.Uuid
  code              String             @unique @db.VarChar(32)
  name              String             @db.VarChar(200)
  /// Free text until the university's course hierarchy is confirmed (e.g. "UG", "PG", "Diploma").
  level             String?            @db.VarChar(64)
  /// Legacy (Phase 2). Kept in sync by the API: the period count for SEMESTER_WISE programs, else null.
  durationSemesters Int?               @map("duration_semesters") @db.SmallInt
  description       String?            @db.VarChar(1000)
  /// Duration as the university states it (e.g. 1 YEARS, 18 MONTHS); validated separately from periods.
  durationValue     Int?               @map("duration_value") @db.SmallInt
  durationUnit      DurationUnit?      @map("duration_unit")
  /// Default structure for new curriculum versions. Null for legacy programs without one.
  academicStructure AcademicStructure? @map("academic_structure")
  /// Number of semesters (SEMESTER_WISE) or years (YEAR_WISE).
  periodCount       Int?               @map("period_count") @db.SmallInt
  /// Optional: not every university structure groups programs under departments.
  departmentId      String?            @map("department_id") @db.Uuid
  status            MasterDataStatus   @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  department        Department?               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  registrations     StudentRegistration[]
  curriculum        ProgramSubject[]
  curricula         ProgramCurriculum[]
  gradingSchemes    GradingScheme[]
  examinations      Examination[]
  documentTemplates ProgramDocumentTemplate[]
  certificates      Certificate[]

  @@index([departmentId])
  @@map("programs")
}

model AcademicSession {
  id        String                @id @default(uuid(7)) @db.Uuid
  code      String                @unique @db.VarChar(32)
  name      String                @db.VarChar(120)
  startsOn  DateTime?             @map("starts_on") @db.Date
  endsOn    DateTime?             @map("ends_on") @db.Date
  status    AcademicSessionStatus @default(UPCOMING)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  registrations StudentRegistration[]
  examinations  Examination[]

  @@map("academic_sessions")
}

// ============================================================================================
// Students
// ============================================================================================

/// A person. Holds identity data only; academic enrolment lives in StudentRegistration so one
/// person can later hold several registrations without duplicating identity.
model Student {
  id              String    @id @default(uuid(7)) @db.Uuid
  fullName        String    @map("full_name") @db.VarChar(200)
  fatherName      String?   @map("father_name") @db.VarChar(200)
  motherName      String?   @map("mother_name") @db.VarChar(200)
  /// Optional. NOT a public lookup factor — the second lookup identifier is unconfirmed.
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          String?   @db.VarChar(32)
  photoStorageKey String?   @map("photo_storage_key") @db.VarChar(512)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  registrations         StudentRegistration[]
  account               StudentAccount?
  profileChangeRequests StudentProfileChangeRequest[]
  reExamApplications    ReExamApplication[]
  reExamPayments        ReExamPayment[]

  @@map("students")
}

/// A student's enrolment in a program. Registration Number is the primary human academic
/// identifier and the anchor for results, certificates and public verification.
model StudentRegistration {
  id                           String        @id @default(uuid(7)) @db.Uuid
  studentId                    String        @map("student_id") @db.Uuid
  /// Official registration number exactly as issued (trimmed).
  registrationNumber           String        @map("registration_number") @db.VarChar(64)
  /// upper(btrim(registration_number)); uniqueness and case-insensitive lookups use this.
  /// Kept in sync by a CHECK constraint, so it can never disagree with registration_number.
  registrationNumberNormalized String        @unique @map("registration_number_normalized") @db.VarChar(64)
  rollReferenceNumber          String?       @map("roll_reference_number") @db.VarChar(64)
  programId                    String        @map("program_id") @db.Uuid
  departmentId                 String?       @map("department_id") @db.Uuid
  academicSessionId            String        @map("academic_session_id") @db.Uuid
  admissionDate                DateTime?     @map("admission_date") @db.Date
  completionDate               DateTime?     @map("completion_date") @db.Date
  status                       StudentStatus @default(ACTIVE)
  /// Curriculum version this registration follows (Phase 7B). Set only by an explicit staff action;
  /// a trigger keeps it within the registration's program and limits new assignments to ACTIVE versions.
  curriculumId                 String?       @map("curriculum_id") @db.Uuid
  createdAt                    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  student             Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  curriculum          ProgramCurriculum?      @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  program             Program                 @relation(fields: [programId], references: [id], onDelete: Restrict)
  department          Department?             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  academicSession     AcademicSession         @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  results             Result[]
  certificates        Certificate[]
  verificationLogs    VerificationLog[]
  importRows          ImportRow[]
  activationCodes     StudentActivationCode[]
  historicalDocuments HistoricalDocument[]
  reExamApplications  ReExamApplication[]

  /// Target of the certificates (registration, program) composite FK: a certificate's program
  /// must be the registration's program.
  @@unique([id, programId])
  @@index([studentId])
  @@index([rollReferenceNumber])
  @@index([programId, academicSessionId])
  @@index([academicSessionId])
  @@index([departmentId])
  @@index([curriculumId])
  @@map("student_registrations")
}

// ============================================================================================
// Curriculum & grading
// ============================================================================================

/// A curriculum (syllabus) version of a program (Phase 7B): its periods and subject assignments.
/// Lifecycle DRAFT → ACTIVE → ARCHIVED (or DRAFT → ARCHIVED), enforced by a trigger; only DRAFT
/// versions are editable. ACTIVE versions of one program may not have overlapping effective periods.
model ProgramCurriculum {
  id                String            @id @default(uuid(7)) @db.Uuid
  programId         String            @map("program_id") @db.Uuid
  /// Short label, unique within the program (e.g. "2026").
  versionCode       String            @map("version_code") @db.VarChar(32)
  name              String            @db.VarChar(200)
  description       String?           @db.VarChar(1000)
  structureType     AcademicStructure @map("structure_type")
  numberOfPeriods   Int               @map("number_of_periods") @db.SmallInt
  effectiveFrom     DateTime?         @map("effective_from") @db.Date
  effectiveTo       DateTime?         @map("effective_to") @db.Date
  status            CurriculumStatus  @default(DRAFT)
  activatedAt       DateTime?         @map("activated_at") @db.Timestamptz(3)
  activatedByUserId String?           @map("activated_by_user_id") @db.Uuid
  archivedAt        DateTime?         @map("archived_at") @db.Timestamptz(3)
  archivedByUserId  String?           @map("archived_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  program       Program               @relation(fields: [programId], references: [id], onDelete: Restrict)
  activatedBy   User?                 @relation("CurriculumActivatedBy", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  archivedBy    User?                 @relation("CurriculumArchivedBy", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  subjects      ProgramSubject[]
  registrations StudentRegistration[]
  examinations  Examination[]

  @@unique([programId, versionCode])
  /// Target of the program_subjects (curriculum, program) composite FK.
  @@unique([id, programId])
  @@index([programId, status])
  @@map("program_curricula")
}

/// A reusable subject definition; the existing (code, version) key is preserved.
/// Catalogue identity is frozen once referenced by active curricula or historical results.
model Subject {
  id             String           @id @default(uuid(7)) @db.Uuid
  code           String           @db.VarChar(32)
  version        Int              @default(1) @db.SmallInt
  name           String           @db.VarChar(200)
  description    String?          @db.VarChar(1000)
  /// Catalogue default; an assignment may classify the subject differently in a curriculum.
  category       SubjectCategory?
  defaultCredits Decimal?         @map("default_credits") @db.Decimal(5, 2)
  status         MasterDataStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  programSubjects    ProgramSubject[]
  reExamApplications ReExamApplication[]

  @@unique([code, version])
  @@map("subjects")
}

/// A subject's place in a program's curriculum for one curriculum version (e.g. a regulation
/// year). Result items point here, so historic results keep the exact credits/marks they used.
/// A subject's placement and assessment configuration in one curriculum version (Phase 2 table;
/// Phase 7B links it to `program_curricula`). `semester_number` holds the ACADEMIC PERIOD number —
/// a semester or a year, depending on the curriculum's structure.
model ProgramSubject {
  id                     String           @id @default(uuid(7)) @db.Uuid
  programId              String           @map("program_id") @db.Uuid
  curriculumId           String           @map("curriculum_id") @db.Uuid
  subjectId              String           @map("subject_id") @db.Uuid
  semesterNumber         Int              @map("semester_number") @db.SmallInt
  /// Order within the period (ascending).
  displayOrder           Int              @default(0) @map("display_order") @db.SmallInt
  /// Mirrors program_curricula.version_code (set by a trigger); kept for the Phase 2 unique key.
  curriculumVersion      String           @map("curriculum_version") @db.VarChar(32)
  classification         SubjectCategory?
  credits                Decimal?         @db.Decimal(5, 2)
  maxMarks               Decimal?         @map("max_marks") @db.Decimal(7, 2)
  passMarks              Decimal?         @map("pass_marks") @db.Decimal(7, 2)
  /// Assessment components (e.g. internal/external/practical maxima). Shape is defined by the
  /// grading rules once confirmed; not interpreted by the database.
  componentConfiguration Json?            @map("component_configuration")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  program            Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  /// Composite FK: the curriculum always belongs to the same program.
  curriculum         ProgramCurriculum   @relation(fields: [curriculumId, programId], references: [id, programId], onDelete: Restrict)
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  resultItems        ResultItem[]
  reExamApplications ReExamApplication[]

  /// A subject appears at most once per curriculum version of a program.
  @@unique([programId, curriculumVersion, subjectId])
  @@unique([curriculumId, subjectId])
  @@index([curriculumId, semesterNumber, displayOrder])
  @@index([programId, curriculumVersion, semesterNumber])
  @@index([subjectId])
  @@map("program_subjects")
}

/// Grading rules as DATA. `rules` holds boundaries, grade points, rounding, fail/absent and credit
/// handling once the university confirms them. ACTIVE/ARCHIVED versions are immutable (trigger);
/// changes create a new version.
model GradingScheme {
  id            String              @id @default(uuid(7)) @db.Uuid
  name          String              @db.VarChar(120)
  version       Int                 @db.SmallInt
  /// Optional program scope; null = usable by any program.
  programId     String?             @map("program_id") @db.Uuid
  effectiveFrom DateTime?           @map("effective_from") @db.Date
  effectiveTo   DateTime?           @map("effective_to") @db.Date
  rules         Json
  status        GradingSchemeStatus @default(DRAFT)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  program      Program?      @relation(fields: [programId], references: [id], onDelete: Restrict)
  examinations Examination[]
  results      Result[]

  @@unique([name, version])
  @@index([programId])
  @@map("grading_schemes")
}

// ============================================================================================
// Examinations & results
// ============================================================================================

model Examination {
  id                     String            @id @default(uuid(7)) @db.Uuid
  code                   String            @unique @db.VarChar(64)
  name                   String            @db.VarChar(200)
  programId              String            @map("program_id") @db.Uuid
  academicSessionId      String            @map("academic_session_id") @db.Uuid
  semesterNumber         Int               @map("semester_number") @db.SmallInt
  /// Free text until confirmed (e.g. "REGULAR", "SUPPLEMENTARY").
  examType               String?           @map("exam_type") @db.VarChar(32)
  /// When the examination was held, as the university labels it (e.g. "May–June 2026").
  examSession            String            @map("exam_session") @db.VarChar(64)
  gradingSchemeId        String?           @map("grading_scheme_id") @db.Uuid
  status                 ExaminationStatus @default(DRAFT)
  publishedAt            DateTime?         @map("published_at") @db.Timestamptz(3)
  /// Curriculum version this examination belongs to (Phase 9). `semester_number` is then a period of
  /// that curriculum (a semester or a year). Required by the API for new records; null only for
  /// rows created before Phase 9.
  curriculumId           String?           @map("curriculum_id") @db.Uuid
  kind                   ExaminationKind   @default(REGULAR)
  /// Re-examinations only: students may apply while this is true (and the examination is OPEN).
  reExamApplicationsOpen Boolean           @default(false) @map("re_exam_applications_open")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  program            Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  /// Composite FK: the curriculum always belongs to the examination's program.
  curriculum         ProgramCurriculum?  @relation(fields: [curriculumId, programId], references: [id, programId], onDelete: Restrict)
  academicSession    AcademicSession     @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  gradingScheme      GradingScheme?      @relation(fields: [gradingSchemeId], references: [id], onDelete: Restrict)
  results            Result[]
  reExamApplications ReExamApplication[]

  @@index([curriculumId, status])
  @@index([programId, academicSessionId, semesterNumber])
  @@index([academicSessionId])
  @@index([gradingSchemeId])
  @@index([status])
  @@map("examinations")
}

/// One student's result for one examination attempt, as one immutable revision.
///
/// Revision rules (enforced by constraints + triggers):
/// - (registration, examination, attempt, revision) is unique.
/// - Revision 1 has no predecessor; revision N > 1 supersedes revision N-1 of the same attempt.
/// - A result can be superseded at most once (linear history).
/// - At most one PUBLISHED and at most one in-progress (DRAFT/UNDER_REVIEW/APPROVED) revision per
///   attempt.
/// - PUBLISHED rows are frozen: only PUBLISHED → SUPERSEDED/WITHHELD transitions are allowed; nothing
///   else changes and the row cannot be deleted. SUPERSEDED rows are fully frozen.
model Result {
  id                    String                  @id @default(uuid(7)) @db.Uuid
  studentRegistrationId String                  @map("student_registration_id") @db.Uuid
  examinationId         String                  @map("examination_id") @db.Uuid
  attemptNumber         Int                     @default(1) @map("attempt_number") @db.SmallInt
  revisionNumber        Int                     @default(1) @map("revision_number") @db.SmallInt
  supersedesResultId    String?                 @unique @map("supersedes_result_id") @db.Uuid
  /// Marks obtained across all items.
  totalMarks            Decimal?                @map("total_marks") @db.Decimal(7, 2)
  /// Maximum attainable marks across all items.
  maxMarks              Decimal?                @map("max_marks") @db.Decimal(7, 2)
  sgpa                  Decimal?                @db.Decimal(5, 3)
  cgpa                  Decimal?                @db.Decimal(5, 3)
  /// Required once APPROVED/PUBLISHED (CHECK); may be null while a draft is being prepared.
  outcome               ResultOutcome?
  publicationStatus     ResultPublicationStatus @default(DRAFT) @map("publication_status")
  /// The exact grading scheme version used. With calculation_snapshot this makes the published
  /// figures reproducible even if newer schemes exist.
  gradingSchemeId       String?                 @map("grading_scheme_id") @db.Uuid
  calculationSnapshot   Json?                   @map("calculation_snapshot")
  approvedAt            DateTime?               @map("approved_at") @db.Timestamptz(3)
  publishedAt           DateTime?               @map("published_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  studentRegistration StudentRegistration @relation(fields: [studentRegistrationId], references: [id], onDelete: Restrict)
  examination         Examination         @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  gradingScheme       GradingScheme?      @relation(fields: [gradingSchemeId], references: [id], onDelete: Restrict)
  supersedes          Result?             @relation("ResultRevision", fields: [supersedesResultId], references: [id], onDelete: Restrict)
  supersededBy        Result?             @relation("ResultRevision")
  items               ResultItem[]
  verificationLogs    VerificationLog[]

  @@unique([studentRegistrationId, examinationId, attemptNumber, revisionNumber])
  // Partial-index predicates are written exactly as PostgreSQL normalises them (pg_get_expr), so
  // Prisma's drift detection compares equal strings. `IN (...)` would be reported as drift forever.
  @@unique([studentRegistrationId, examinationId, attemptNumber], map: "results_one_published_per_attempt_key", where: raw("publication_status = 'PUBLISHED'"))
  @@unique([studentRegistrationId, examinationId, attemptNumber], map: "results_one_working_revision_per_attempt_key", where: raw("publication_status = ANY (ARRAY['DRAFT'::\"ResultPublicationStatus\", 'UNDER_REVIEW'::\"ResultPublicationStatus\", 'APPROVED'::\"ResultPublicationStatus\"])"))
  @@index([examinationId, publicationStatus])
  @@index([gradingSchemeId])
  @@map("results")
}

/// One subject line of a result. Editable only while the parent result is a working draft
/// (DRAFT/UNDER_REVIEW); frozen afterwards (trigger).
model ResultItem {
  id               String           @id @default(uuid(7)) @db.Uuid
  resultId         String           @map("result_id") @db.Uuid
  programSubjectId String           @map("program_subject_id") @db.Uuid
  internalMarks    Decimal?         @map("internal_marks") @db.Decimal(7, 2)
  externalMarks    Decimal?         @map("external_marks") @db.Decimal(7, 2)
  practicalMarks   Decimal?         @map("practical_marks") @db.Decimal(7, 2)
  otherMarks       Decimal?         @map("other_marks") @db.Decimal(7, 2)
  /// Marks obtained for this subject.
  totalMarks       Decimal?         @map("total_marks") @db.Decimal(7, 2)
  maxMarks         Decimal?         @map("max_marks") @db.Decimal(7, 2)
  grade            String?          @db.VarChar(8)
  gradePoint       Decimal?         @map("grade_point") @db.Decimal(5, 3)
  creditsAttempted Decimal?         @map("credits_attempted") @db.Decimal(5, 2)
  creditsEarned    Decimal?         @map("credits_earned") @db.Decimal(5, 2)
  status           ResultItemStatus
  /// Original imported values for traceability (e.g. the spreadsheet cells this line came from).
  sourceData       Json?            @map("source_data")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  result         Result         @relation(fields: [resultId], references: [id], onDelete: Cascade)
  programSubject ProgramSubject @relation(fields: [programSubjectId], references: [id], onDelete: Restrict)

  /// One line per subject per result revision.
  @@unique([resultId, programSubjectId])
  @@index([programSubjectId])
  @@map("result_items")
}

// ============================================================================================
// Documents & certificates
// ============================================================================================

/// A versioned document template. Only DRAFT templates can be edited; ACTIVE/ARCHIVED versions are
/// frozen (trigger) and changes create a new version. Issued certificates additionally keep their
/// own source snapshot and PDF hash, so a template change can never alter an issued document.
model CertificateTemplate {
  id                   String          @id @default(uuid(7)) @db.Uuid
  name                 String          @db.VarChar(120)
  documentType         DocumentType    @map("document_type")
  version              Int             @db.SmallInt
  pageSize             String          @default("A4") @map("page_size") @db.VarChar(16)
  orientation          PageOrientation @default(PORTRAIT)
  templateMarkup       String?         @map("template_markup")
  templateStyles       String?         @map("template_styles")
  backgroundStorageKey String?         @map("background_storage_key") @db.VarChar(512)
  status               TemplateStatus  @default(DRAFT)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  programMappings ProgramDocumentTemplate[]
  certificates    Certificate[]

  @@unique([name, version])
  /// Target of the program_document_templates composite FK (template must match document type).
  @@unique([id, documentType])
  @@index([documentType, status])
  @@map("certificate_templates")
}

/// Which template a program uses for a document type.
/// Deterministic selection: at most one default per (program, document type) (partial unique), and
/// effective date ranges for the same (program, document type) may not overlap (trigger).
model ProgramDocumentTemplate {
  id                    String       @id @default(uuid(7)) @db.Uuid
  programId             String       @map("program_id") @db.Uuid
  documentType          DocumentType @map("document_type")
  certificateTemplateId String       @map("certificate_template_id") @db.Uuid
  effectiveFrom         DateTime?    @map("effective_from") @db.Date
  effectiveTo           DateTime?    @map("effective_to") @db.Date
  isDefault             Boolean      @default(false) @map("is_default")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  program  Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  /// Composite FK: the mapping's document type must equal the template's document type.
  template CertificateTemplate @relation(fields: [certificateTemplateId, documentType], references: [id, documentType], onDelete: Restrict, onUpdate: Restrict)

  @@unique([programId, documentType], map: "program_document_templates_one_default_key", where: raw("is_default"))
  @@index([programId, documentType])
  @@index([certificateTemplateId])
  @@map("program_document_templates")
}

/// Counter for human-readable certificate numbers. Allocation (later) is a single
/// `UPDATE … SET current_value = current_value + 1 … RETURNING` inside the issuing transaction,
/// which row-locks the sequence and guarantees no duplicates under concurrency.
model NumberSequence {
  id            String   @id @default(uuid(7)) @db.Uuid
  key           String   @unique @db.VarChar(64)
  prefix        String   @default("") @db.VarChar(32)
  currentValue  BigInt   @default(0) @map("current_value")
  padding       Int      @default(5) @db.SmallInt
  yearlyReset   Boolean  @default(false) @map("yearly_reset")
  lastResetYear Int?     @map("last_reset_year") @db.SmallInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("number_sequences")
}

/// THE single authoritative credential record. Certificate-number and QR-token verification both
/// resolve to this table — there is no second certificate store.
///
/// - certificate_number and verification_token are unique when present (NULLs allowed until issue).
/// - Issued certificates are frozen (trigger): only ISSUED → REVOKED/SUPERSEDED transitions and their
///   bookkeeping fields may change; number, token, snapshot and PDF hash never change.
/// - A replacement supersedes exactly one certificate of the same registration and document type.
model Certificate {
  id                      String            @id @default(uuid(7)) @db.Uuid
  certificateNumber       String?           @unique @map("certificate_number") @db.VarChar(64)
  /// Opaque random token encoded in the QR URL (≥ 22 chars ≈ 128 bits base64url; CHECK).
  verificationToken       String?           @unique @map("verification_token") @db.VarChar(128)
  studentRegistrationId   String            @map("student_registration_id") @db.Uuid
  programId               String            @map("program_id") @db.Uuid
  documentType            DocumentType      @map("document_type")
  certificateTemplateId   String?           @map("certificate_template_id") @db.Uuid
  issueDate               DateTime?         @map("issue_date") @db.Date
  status                  CertificateStatus @default(DRAFT)
  /// Frozen copy of every value printed on the document at issue time.
  sourceSnapshot          Json?             @map("source_snapshot")
  pdfStorageKey           String?           @map("pdf_storage_key") @db.VarChar(512)
  /// Hex SHA-256 of the issued PDF.
  pdfHash                 String?           @map("pdf_hash") @db.VarChar(128)
  generatedByUserId       String?           @map("generated_by_user_id") @db.Uuid
  approvedByUserId        String?           @map("approved_by_user_id") @db.Uuid
  issuedByUserId          String?           @map("issued_by_user_id") @db.Uuid
  approvedAt              DateTime?         @map("approved_at") @db.Timestamptz(3)
  issuedAt                DateTime?         @map("issued_at") @db.Timestamptz(3)
  revokedByUserId         String?           @map("revoked_by_user_id") @db.Uuid
  revokedAt               DateTime?         @map("revoked_at") @db.Timestamptz(3)
  revocationReason        String?           @map("revocation_reason")
  cancelledAt             DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason      String?           @map("cancellation_reason")
  supersedesCertificateId String?           @unique @map("supersedes_certificate_id") @db.Uuid
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  studentRegistration StudentRegistration  @relation(fields: [studentRegistrationId, programId], references: [id, programId], onDelete: Restrict, onUpdate: Restrict)
  program             Program              @relation(fields: [programId], references: [id], onDelete: Restrict)
  template            CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id], onDelete: Restrict)
  generatedBy         User?                @relation("CertificateGeneratedBy", fields: [generatedByUserId], references: [id], onDelete: Restrict)
  approvedBy          User?                @relation("CertificateApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  issuedBy            User?                @relation("CertificateIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  revokedBy           User?                @relation("CertificateRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  supersedes          Certificate?         @relation("CertificateSupersession", fields: [supersedesCertificateId], references: [id], onDelete: Restrict)
  supersededBy        Certificate?         @relation("CertificateSupersession")
  verificationLogs    VerificationLog[]

  @@index([studentRegistrationId, documentType])
  @@index([status])
  @@index([documentType, status])
  @@index([programId])
  @@index([certificateTemplateId])
  @@map("certificates")
}

// ============================================================================================
// Imports
// ============================================================================================

/// One spreadsheet import (students or results). The worker parses, validates and commits it
/// (Phase 5: students); every step is persisted so the wizard survives reloads and restarts.
model ImportJob {
  id                    String       @id @default(uuid(7)) @db.Uuid
  type                  ImportType
  /// Original filename — display metadata only, never used as a storage path.
  originalFilename      String       @map("original_filename") @db.VarChar(255)
  /// Generated private object key of the uploaded workbook.
  storageKey            String?      @map("storage_key") @db.VarChar(512)
  fileSizeBytes         Int?         @map("file_size_bytes")
  /// Lower-case hex SHA-256 of the uploaded bytes (duplicate-upload hint, integrity evidence).
  fileSha256            String?      @map("file_sha256") @db.Char(64)
  status                ImportStatus @default(UPLOADED)
  /// Persisted progress (0–100) of the running worker step; the UI never fakes progress.
  progress              Int          @default(0) @db.SmallInt
  /// Identifies the worker run allowed to write; a stale or duplicate job with another id is ignored.
  activeRunId           String?      @map("active_run_id") @db.Uuid
  /// Worksheets found when the workbook was read: name, row/column counts, headers, suggestions.
  sheets                Json?
  /// The worksheet chosen for validation.
  worksheetName         String?      @map("worksheet_name") @db.VarChar(31)
  totalRows             Int          @default(0) @map("total_rows")
  validRows             Int          @default(0) @map("valid_rows")
  warningRows           Int          @default(0) @map("warning_rows")
  errorRows             Int          @default(0) @map("error_rows")
  /// Validation classification of importable rows.
  createRows            Int          @default(0) @map("create_rows")
  updateRows            Int          @default(0) @map("update_rows")
  unchangedRows         Int          @default(0) @map("unchanged_rows")
  importedRows          Int          @default(0) @map("imported_rows")
  skippedRows           Int          @default(0) @map("skipped_rows")
  /// Commit results.
  createdRecords        Int          @default(0) @map("created_records")
  updatedRecords        Int          @default(0) @map("updated_records")
  /// Confirmed column → field mapping (plus parsing options such as the text date format).
  mapping               Json?
  /// Whether the commit was explicitly approved to apply updates to existing records.
  applyUpdates          Boolean      @default(false) @map("apply_updates")
  /// Safe failure summary { stage, code, message, retryable } — never a stack trace.
  failure               Json?
  errorReportStorageKey String?      @map("error_report_storage_key") @db.VarChar(512)
  errorReportCreatedAt  DateTime?    @map("error_report_created_at") @db.Timestamptz(3)
  createdByUserId       String?      @map("created_by_user_id") @db.Uuid
  committedByUserId     String?      @map("committed_by_user_id") @db.Uuid
  startedAt             DateTime?    @map("started_at") @db.Timestamptz(3)
  validatedAt           DateTime?    @map("validated_at") @db.Timestamptz(3)
  completedAt           DateTime?    @map("completed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User?       @relation("ImportJobCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  committedBy User?       @relation("ImportJobCommittedBy", fields: [committedByUserId], references: [id], onDelete: Restrict)
  rows        ImportRow[]

  @@index([type, status, createdAt(sort: Desc)])
  @@index([createdByUserId])
  @@index([committedByUserId])
  @@index([createdAt(sort: Desc)])
  @@map("import_jobs")
}

/// One spreadsheet row of an import job (staging data — rows belong to their job).
model ImportRow {
  id             String           @id @default(uuid(7)) @db.Uuid
  importJobId    String           @map("import_job_id") @db.Uuid
  /// 1-based spreadsheet row number as the user sees it.
  rowNumber      Int              @map("row_number")
  status         ImportRowStatus
  /// What committing the row does. NULL exactly when the row has errors (CHECK).
  action         ImportRowAction?
  /// The existing registration (UPDATE/SKIP) or the one created by the commit (CREATE).
  registrationId String?          @map("registration_id") @db.Uuid
  /// The source cells exactly as read (never modified).
  rawData        Json             @map("raw_data")
  normalizedData Json?            @map("normalized_data")
  errors         Json?
  warnings       Json?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  importJob    ImportJob            @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  registration StudentRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@unique([importJobId, rowNumber])
  @@index([importJobId, status])
  @@index([importJobId, action])
  @@index([registrationId])
  @@map("import_rows")
}

// ============================================================================================
// Student portal accounts (Phase 6) — a separate principal from staff users
// ============================================================================================

/// A student's portal account: exactly one per student (person), covering all of their
/// registrations. Never linked to staff users, roles or permissions. Created only by activation.
model StudentAccount {
  id                String               @id @default(uuid(7)) @db.Uuid
  studentId         String               @unique @map("student_id") @db.Uuid
  /// Argon2id hash (CHECK). Students always choose their own password.
  passwordHash      String               @map("password_hash")
  status            StudentAccountStatus @default(ACTIVE)
  /// Why staff locked/disabled the account (required when DISABLED).
  statusReason      String?              @map("status_reason") @db.VarChar(500)
  activatedAt       DateTime             @default(now()) @map("activated_at") @db.Timestamptz(3)
  passwordChangedAt DateTime             @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?            @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  student                 Student                       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  profileChangeRequests   StudentProfileChangeRequest[]
  reExamApplications      ReExamApplication[]
  reExamPaymentsStarted   ReExamPayment[]               @relation("ReExamPaymentCreatedBy")
  reExamPaymentsSubmitted ReExamPayment[]               @relation("ReExamPaymentSubmittedBy")

  @@index([status])
  @@map("student_accounts")
}

/// A single-use activation code proving ownership of one registration. Only an HMAC of the code is
/// stored; the plain code is shown once to staff for delivery. At most one OPEN (unused, unrevoked)
/// code per registration.
model StudentActivationCode {
  id                    String    @id @default(uuid(7)) @db.Uuid
  studentRegistrationId String    @map("student_registration_id") @db.Uuid
  /// HMAC-SHA256 (hex) of the normalised code — never the code itself.
  codeHash              String    @unique @map("code_hash") @db.Char(64)
  issuedByUserId        String?   @map("issued_by_user_id") @db.Uuid
  issuedAt              DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt                DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Wrong codes entered for this registration while the code was open; the code is revoked at the limit.
  failedAttempts        Int       @default(0) @map("failed_attempts") @db.SmallInt
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  registration StudentRegistration @relation(fields: [studentRegistrationId], references: [id], onDelete: Restrict)
  issuedBy     User?               @relation(fields: [issuedByUserId], references: [id], onDelete: Restrict)

  @@unique([studentRegistrationId], map: "student_activation_codes_one_open_per_registration_key", where: raw("((used_at IS NULL) AND (revoked_at IS NULL))"))
  @@index([studentRegistrationId, issuedAt(sort: Desc)])
  @@map("student_activation_codes")
}

// ============================================================================================
// Users & roles (schema only — authentication is Phase 3)
// ============================================================================================

/// A student's request to correct or complete their own personal details (Phase 7).
/// Submission data is immutable (trigger); only the decision columns change, once, from PENDING.
/// The official `students` row changes only when staff approve, inside the same transaction.
model StudentProfileChangeRequest {
  id                   String                     @id @default(uuid(7)) @db.Uuid
  studentId            String                     @map("student_id") @db.Uuid
  /// The student account (session) that submitted it — never a client-supplied ID.
  submittedByAccountId String                     @map("submitted_by_account_id") @db.Uuid
  status               ProfileChangeRequestStatus @default(PENDING)
  /// Proposed values for the requested text/date fields only, e.g. {"dateOfBirth":"2001-04-05"}.
  proposedChanges      Json                       @map("proposed_changes")
  /// Official values of every profile field at submission (staleness check and review comparison).
  currentSnapshot      Json                       @map("current_snapshot")
  /// Optional explanation from the student.
  studentNote          String?                    @map("student_note") @db.VarChar(500)
  /// Staged, normalised JPEG under a generated key (private storage). Null = no photo change.
  photoStorageKey      String?                    @map("photo_storage_key") @db.VarChar(512)
  photoSha256          String?                    @map("photo_sha256") @db.Char(64)
  photoSizeBytes       Int?                       @map("photo_size_bytes")
  photoWidth           Int?                       @map("photo_width") @db.SmallInt
  photoHeight          Int?                       @map("photo_height") @db.SmallInt
  /// students.photo_storage_key at submission (internal; never returned) — detects a replaced photo.
  basePhotoStorageKey  String?                    @map("base_photo_storage_key") @db.VarChar(512)
  submittedAt          DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedByUserId     String?                    @map("reviewed_by_user_id") @db.Uuid
  reviewedAt           DateTime?                  @map("reviewed_at") @db.Timestamptz(3)
  /// Required when REJECTED; shown to the student.
  rejectionReason      String?                    @map("rejection_reason") @db.VarChar(1000)
  cancelledAt          DateTime?                  @map("cancelled_at") @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  student     Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  submittedBy StudentAccount @relation(fields: [submittedByAccountId], references: [id], onDelete: Restrict)
  reviewedBy  User?          @relation(fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  /// At most one open request per student, so two requests can never compete for the same record.
  @@unique([studentId], map: "student_profile_change_requests_one_pending_per_student_key", where: raw("(status = 'PENDING'::\"ProfileChangeRequestStatus\")"))
  @@index([studentId, submittedAt(sort: Desc)])
  @@index([status, submittedAt(sort: Desc)])
  @@map("student_profile_change_requests")
}

/// A historical certificate/marksheet uploaded by staff for one registration (Phase 8).
/// Evidence of a previously issued document — NOT a Docversity-issued credential (those live in
/// `certificates`). Students see it only while PUBLISHED. The file and its identity are immutable;
/// metadata changes only while DRAFT; corrections after publication use a replacement. Never deleted.
model HistoricalDocument {
  id                           String                     @id @default(uuid(7)) @db.Uuid
  studentRegistrationId        String                     @map("student_registration_id") @db.Uuid
  documentType                 HistoricalDocumentType     @map("document_type")
  title                        String                     @db.VarChar(200)
  /// Certificate number exactly as provided (never trimmed or rewritten; rows created before the
  /// Phase 8 hardening migration were stored trimmed).
  certificateNumber            String?                    @map("certificate_number") @db.VarChar(64)
  /// Search/duplicate-detection form of `certificateNumber` (NFKC, upper-case, letters and digits
  /// only; see `normalizeCertificateNumber`). Never displayed as the number.
  certificateNumberNormalized  String?                    @map("certificate_number_normalized") @db.VarChar(128)
  issuedOn                     DateTime?                  @map("issued_on") @db.Date
  provenance                   DocumentProvenance
  provenanceNote               String?                    @map("provenance_note") @db.VarChar(1000)
  /// Identifiers of the record in a legacy system (e.g. WordPress), preserved as given — never rewritten.
  legacySourceSystem           String?                    @map("legacy_source_system") @db.VarChar(32)
  legacyRecordId               String?                    @map("legacy_record_id") @db.VarChar(128)
  /// Verification URL printed on the original (e.g. its QR code). Reference only; never fetched.
  legacyVerificationUrl        String?                    @map("legacy_verification_url") @db.VarChar(512)
  /// Private object under a generated key; never returned by the API.
  storageKey                   String                     @map("storage_key") @db.VarChar(512)
  contentType                  String                     @map("content_type") @db.VarChar(64)
  sizeBytes                    Int                        @map("size_bytes")
  sha256                       String                     @db.Char(64)
  /// Uploaded file name, sanitised; display only.
  originalFilename             String                     @map("original_filename") @db.VarChar(255)
  /// Images only: the copy students receive — re-encoded from the original without embedded
  /// metadata, stored as a separate private object. Set once (at upload or by the backfill), then
  /// immutable; an image cannot be published without it.
  studentCopyStorageKey        String?                    @map("student_copy_storage_key") @db.VarChar(512)
  studentCopyContentType       String?                    @map("student_copy_content_type") @db.VarChar(64)
  studentCopySizeBytes         Int?                       @map("student_copy_size_bytes")
  studentCopySha256            String?                    @map("student_copy_sha256") @db.Char(64)
  studentCopyCreatedAt         DateTime?                  @map("student_copy_created_at") @db.Timestamptz(3)
  /// Kinds of metadata found embedded in the original image (never the values). Recorded together
  /// with the student copy; empty for PDFs.
  embeddedMetadata             EmbeddedMetadataCategory[] @default([]) @map("embedded_metadata")
  status                       HistoricalDocumentStatus   @default(DRAFT)
  uploadedByUserId             String                     @map("uploaded_by_user_id") @db.Uuid
  publishedAt                  DateTime?                  @map("published_at") @db.Timestamptz(3)
  publishedByUserId            String?                    @map("published_by_user_id") @db.Uuid
  withdrawnAt                  DateTime?                  @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnByUserId            String?                    @map("withdrawn_by_user_id") @db.Uuid
  withdrawalReason             String?                    @map("withdrawal_reason") @db.VarChar(1000)
  supersededAt                 DateTime?                  @map("superseded_at") @db.Timestamptz(3)
  /// The document this one replaces (same registration).
  replacesDocumentId           String?                    @map("replaces_document_id") @db.Uuid
  authenticity                 DocumentAuthenticity       @default(UNVERIFIED)
  authenticityNote             String?                    @map("authenticity_note") @db.VarChar(1000)
  authenticityReviewedAt       DateTime?                  @map("authenticity_reviewed_at") @db.Timestamptz(3)
  authenticityReviewedByUserId String?                    @map("authenticity_reviewed_by_user_id") @db.Uuid
  createdAt                    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  registration StudentRegistration  @relation(fields: [studentRegistrationId], references: [id], onDelete: Restrict)
  uploadedBy   User                 @relation("HistoricalDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  publishedBy  User?                @relation("HistoricalDocumentPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  withdrawnBy  User?                @relation("HistoricalDocumentWithdrawnBy", fields: [withdrawnByUserId], references: [id], onDelete: Restrict)
  reviewedBy   User?                @relation("HistoricalDocumentReviewedBy", fields: [authenticityReviewedByUserId], references: [id], onDelete: Restrict)
  replaces     HistoricalDocument?  @relation("HistoricalDocumentReplacement", fields: [replacesDocumentId], references: [id], onDelete: Restrict)
  replacements HistoricalDocument[] @relation("HistoricalDocumentReplacement")

  /// The same file is not uploaded twice for one registration (withdrawn copies excepted).
  @@unique([studentRegistrationId, sha256], map: "historical_documents_one_file_per_registration_key", where: raw("(status <> 'WITHDRAWN'::\"HistoricalDocumentStatus\")"))
  /// At most one live replacement per document.
  @@unique([replacesDocumentId], map: "historical_documents_one_live_replacement_key", where: raw("((replaces_document_id IS NOT NULL) AND (status <> 'WITHDRAWN'::\"HistoricalDocumentStatus\"))"))
  @@index([studentRegistrationId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([certificateNumber])
  @@index([certificateNumberNormalized])
  @@map("historical_documents")
}

/// A versioned re-exam fee schedule (Phase 9B). Amounts are integer minor units of `currency`.
/// DRAFT rules are editable; ACTIVE and RETIRED rules (and their rates) are frozen (trigger). At most
/// one ACTIVE rule. Applications snapshot the rule they were assessed with.
model ReExamFeeRule {
  id                String              @id @default(uuid(7)) @db.Uuid
  version           Int                 @unique
  status            ReExamFeeRuleStatus @default(DRAFT)
  scope             ReExamFeeScope
  /// ISO 4217 code (e.g. INR).
  currency          String              @db.Char(3)
  /// How attempts are counted for this rule (stored so later policy changes stay traceable).
  attemptBasis      String              @map("attempt_basis") @db.VarChar(64)
  note              String?             @db.VarChar(1000)
  createdByUserId   String              @map("created_by_user_id") @db.Uuid
  activatedAt       DateTime?           @map("activated_at") @db.Timestamptz(3)
  activatedByUserId String?             @map("activated_by_user_id") @db.Uuid
  retiredAt         DateTime?           @map("retired_at") @db.Timestamptz(3)
  retiredByUserId   String?             @map("retired_by_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy    User                @relation("ReExamFeeRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activatedBy  User?               @relation("ReExamFeeRuleActivatedBy", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  retiredBy    User?               @relation("ReExamFeeRuleRetiredBy", fields: [retiredByUserId], references: [id], onDelete: Restrict)
  rates        ReExamFeeRate[]
  applications ReExamApplication[]
  payments     ReExamPayment[]

  @@unique([status], map: "re_exam_fee_rules_one_active_key", where: raw("(status = 'ACTIVE'::\"ReExamFeeRuleStatus\")"))
  @@map("re_exam_fee_rules")
}

/// The fee for one attempt number under a fee rule. Attempts without a rate have no approved fee.
model ReExamFeeRate {
  ruleId        String @map("rule_id") @db.Uuid
  attemptNumber Int    @map("attempt_number") @db.SmallInt
  amountMinor   Int    @map("amount_minor")

  rule ReExamFeeRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@id([ruleId, attemptNumber])
  @@map("re_exam_fee_rates")
}

/// A student's application for a re-examination of ONE subject (Phase 9B). Identity, attempt and fee
/// are snapshotted by the server at submission; nothing here is client-authoritative. Never deleted.
model ReExamApplication {
  id                    String                  @id @default(uuid(7)) @db.Uuid
  studentId             String                  @map("student_id") @db.Uuid
  studentRegistrationId String                  @map("student_registration_id") @db.Uuid
  examinationId         String                  @map("examination_id") @db.Uuid
  programSubjectId      String                  @map("program_subject_id") @db.Uuid
  /// Catalogue subject (attempts are counted per registration and catalogue subject).
  subjectId             String                  @map("subject_id") @db.Uuid
  attemptNumber         Int                     @map("attempt_number") @db.SmallInt
  attemptBasis          String                  @map("attempt_basis") @db.VarChar(64)
  // Verified identity at submission (read-only for the student).
  studentName           String                  @map("student_name") @db.VarChar(200)
  registrationNumber    String                  @map("registration_number") @db.VarChar(64)
  programCode           String                  @map("program_code") @db.VarChar(32)
  programName           String                  @map("program_name") @db.VarChar(200)
  academicSessionName   String                  @map("academic_session_name") @db.VarChar(120)
  periodLabel           String                  @map("period_label") @db.VarChar(32)
  subjectCode           String                  @map("subject_code") @db.VarChar(32)
  subjectName           String                  @map("subject_name") @db.VarChar(200)
  examinationName       String                  @map("examination_name") @db.VarChar(200)
  examSession           String                  @map("exam_session") @db.VarChar(64)
  status                ReExamApplicationStatus @default(SUBMITTED)
  submittedAt           DateTime                @default(now()) @map("submitted_at") @db.Timestamptz(3)
  submittedByAccountId  String                  @map("submitted_by_account_id") @db.Uuid
  decidedAt             DateTime?               @map("decided_at") @db.Timestamptz(3)
  decidedByUserId       String?                 @map("decided_by_user_id") @db.Uuid
  decisionReason        String?                 @map("decision_reason") @db.VarChar(1000)
  cancelledAt           DateTime?               @map("cancelled_at") @db.Timestamptz(3)
  // Fee snapshot (null while NOT_CONFIGURED).
  feeStatus             ReExamFeeStatus         @map("fee_status")
  feeBlockedReason      String?                 @map("fee_blocked_reason") @db.VarChar(64)
  feeRuleId             String?                 @map("fee_rule_id") @db.Uuid
  feeRuleVersion        Int?                    @map("fee_rule_version")
  feeScope              ReExamFeeScope?         @map("fee_scope")
  feeCurrency           String?                 @map("fee_currency") @db.Char(3)
  feeAmountMinor        Int?                    @map("fee_amount_minor")
  feeAssessedAt         DateTime?               @map("fee_assessed_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  student        Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  registration   StudentRegistration @relation(fields: [studentRegistrationId], references: [id], onDelete: Restrict)
  examination    Examination         @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  programSubject ProgramSubject      @relation(fields: [programSubjectId], references: [id], onDelete: Restrict)
  subject        Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  submittedBy    StudentAccount      @relation(fields: [submittedByAccountId], references: [id], onDelete: Restrict)
  decidedBy      User?               @relation("ReExamApplicationDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  feeRule        ReExamFeeRule?      @relation(fields: [feeRuleId], references: [id], onDelete: Restrict)
  payments       ReExamPayment[]

  /// No second live (SUBMITTED/APPROVED) application for the same registration, examination and subject.
  @@unique([studentRegistrationId, examinationId, subjectId], map: "re_exam_applications_one_live_key", where: raw("(status = ANY (ARRAY['SUBMITTED'::\"ReExamApplicationStatus\", 'APPROVED'::\"ReExamApplicationStatus\"]))"))
  @@index([status, submittedAt(sort: Desc)])
  @@index([examinationId])
  @@index([studentId])
  @@index([studentRegistrationId, subjectId])
  @@map("re_exam_applications")
}

/// Where students of one country/region group pay the re-exam fee (Phase 9C): beneficiary, method,
/// currency, instructions, validity and a private QR image (stored re-encoded, without metadata).
/// Versioned per region; APPROVED (by someone other than its creator) before students can see it;
/// frozen once approved (trigger). Replacing a QR = approving a replacement version, which retires the
/// replaced one. Payment obligations keep pointing at the version they were created with.
model ReExamPaymentDestination {
  id                    String                     @id @default(uuid(7)) @db.Uuid
  region                PaymentRegion
  /// 1, 2, … per region.
  version               Int
  status                PaymentDestinationStatus   @default(DRAFT)
  /// Students see an APPROVED destination only while it is active and in effect.
  isActive              Boolean                    @default(false) @map("is_active")
  /// For region groups only (EUROPE, CENTRAL_ASIA, OTHERS): the country or area it covers, if specific.
  countryName           String?                    @map("country_name") @db.VarChar(100)
  beneficiaryName       String                     @map("beneficiary_name") @db.VarChar(200)
  method                PaymentMethod
  /// ISO 4217 code.
  currency              String                     @db.Char(3)
  instructions          String                     @db.VarChar(2000)
  evidenceRequirement   PaymentEvidenceRequirement @default(OPTIONAL) @map("evidence_requirement")
  effectiveFrom         DateTime                   @map("effective_from") @db.Timestamptz(3)
  effectiveUntil        DateTime?                  @map("effective_until") @db.Timestamptz(3)
  qrStorageKey          String?                    @map("qr_storage_key") @db.VarChar(255)
  qrContentType         String?                    @map("qr_content_type") @db.VarChar(32)
  qrSizeBytes           Int?                       @map("qr_size_bytes")
  qrSha256              String?                    @map("qr_sha256") @db.Char(64)
  /// The APPROVED version of the same region this draft will replace when approved.
  replacesDestinationId String?                    @map("replaces_destination_id") @db.Uuid
  createdByUserId       String                     @map("created_by_user_id") @db.Uuid
  updatedByUserId       String                     @map("updated_by_user_id") @db.Uuid
  approvedAt            DateTime?                  @map("approved_at") @db.Timestamptz(3)
  approvedByUserId      String?                    @map("approved_by_user_id") @db.Uuid
  retiredAt             DateTime?                  @map("retired_at") @db.Timestamptz(3)
  retiredByUserId       String?                    @map("retired_by_user_id") @db.Uuid
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy    User                           @relation("PaymentDestinationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy    User                           @relation("PaymentDestinationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  approvedBy   User?                          @relation("PaymentDestinationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  retiredBy    User?                          @relation("PaymentDestinationRetiredBy", fields: [retiredByUserId], references: [id], onDelete: Restrict)
  replaces     ReExamPaymentDestination?      @relation("PaymentDestinationReplacement", fields: [replacesDestinationId], references: [id], onDelete: Restrict)
  replacements ReExamPaymentDestination[]     @relation("PaymentDestinationReplacement")
  rates        ReExamPaymentDestinationRate[]
  payments     ReExamPayment[]

  @@unique([region, version])
  /// At most one APPROVED destination per region (no ambiguity about which QR a student sees).
  @@unique([region], map: "re_exam_payment_destinations_one_approved_key", where: raw("(status = 'APPROVED'::\"PaymentDestinationStatus\")"))
  @@index([status, region])
  @@map("re_exam_payment_destinations")
}

/// An explicitly approved amount for one re-exam attempt in a destination's currency, used only when
/// that currency differs from the application's assessed fee currency. Never computed.
model ReExamPaymentDestinationRate {
  destinationId String @map("destination_id") @db.Uuid
  attemptNumber Int    @map("attempt_number") @db.SmallInt
  amountMinor   Int    @map("amount_minor")

  destination ReExamPaymentDestination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@id([destinationId, attemptNumber])
  @@map("re_exam_payment_destination_rates")
}

/// A payment obligation for one re-exam application at one destination (Phase 9C), with the amount,
/// currency, fee-rule version and destination version snapshotted when it is created, and the
/// student's submitted transaction reference / evidence and the staff review. Never deleted; at most
/// one live obligation per application; a transaction reference satisfies at most one live payment.
model ReExamPayment {
  id                             String                    @id @default(uuid(7)) @db.Uuid
  applicationId                  String                    @map("application_id") @db.Uuid
  studentId                      String                    @map("student_id") @db.Uuid
  destinationId                  String                    @map("destination_id") @db.Uuid
  region                         PaymentRegion
  destinationVersion             Int                       @map("destination_version")
  attemptNumber                  Int                       @map("attempt_number") @db.SmallInt
  feeRuleId                      String                    @map("fee_rule_id") @db.Uuid
  feeRuleVersion                 Int                       @map("fee_rule_version")
  amountSource                   ReExamPaymentAmountSource @map("amount_source")
  amountMinor                    Int                       @map("amount_minor")
  currency                       String                    @db.Char(3)
  status                         ReExamPaymentStatus       @default(AWAITING_PAYMENT)
  createdByAccountId             String                    @map("created_by_account_id") @db.Uuid
  voidedAt                       DateTime?                 @map("voided_at") @db.Timestamptz(3)
  voidReason                     String?                   @map("void_reason") @db.VarChar(64)
  /// As entered by the student (trimmed), and its normalised form (upper-case letters/digits).
  transactionReference           String?                   @map("transaction_reference") @db.VarChar(64)
  transactionReferenceNormalized String?                   @map("transaction_reference_normalized") @db.VarChar(64)
  submittedAt                    DateTime?                 @map("submitted_at") @db.Timestamptz(3)
  submittedByAccountId           String?                   @map("submitted_by_account_id") @db.Uuid
  evidenceStorageKey             String?                   @map("evidence_storage_key") @db.VarChar(255)
  evidenceContentType            String?                   @map("evidence_content_type") @db.VarChar(32)
  evidenceSizeBytes              Int?                      @map("evidence_size_bytes")
  evidenceSha256                 String?                   @map("evidence_sha256") @db.Char(64)
  reviewedAt                     DateTime?                 @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId               String?                   @map("reviewed_by_user_id") @db.Uuid
  verifiedAmountMinor            Int?                      @map("verified_amount_minor")
  verifiedCurrency               String?                   @map("verified_currency") @db.Char(3)
  reviewNote                     String?                   @map("review_note") @db.VarChar(1000)
  rejectionReason                String?                   @map("rejection_reason") @db.VarChar(1000)
  createdAt                      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  application ReExamApplication        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  student     Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  destination ReExamPaymentDestination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  feeRule     ReExamFeeRule            @relation(fields: [feeRuleId], references: [id], onDelete: Restrict)
  createdBy   StudentAccount           @relation("ReExamPaymentCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  submittedBy StudentAccount?          @relation("ReExamPaymentSubmittedBy", fields: [submittedByAccountId], references: [id], onDelete: Restrict)
  reviewedBy  User?                    @relation("ReExamPaymentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  /// One live (awaiting, submitted or verified) obligation per application.
  @@unique([applicationId], map: "re_exam_payments_one_live_key", where: raw("(status = ANY (ARRAY['AWAITING_PAYMENT'::\"ReExamPaymentStatus\", 'SUBMITTED'::\"ReExamPaymentStatus\", 'VERIFIED'::\"ReExamPaymentStatus\"]))"))
  /// A transaction reference backs at most one submitted or verified payment.
  @@unique([transactionReferenceNormalized], map: "re_exam_payments_one_reference_key", where: raw("(status = ANY (ARRAY['SUBMITTED'::\"ReExamPaymentStatus\", 'VERIFIED'::\"ReExamPaymentStatus\"]))"))
  @@index([status, submittedAt(sort: Desc)])
  @@index([applicationId])
  @@index([studentId])
  @@index([transactionReferenceNormalized])
  @@map("re_exam_payments")
}

/// The university's separate examination application (Phase 9). Docversity only links to it: the
/// examination itself happens outside Docversity. URLs are https only (CHECK).
model ExternalExamApplication {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String   @db.VarChar(120)
  websiteUrl      String   @map("website_url") @db.VarChar(512)
  androidUrl      String?  @map("android_url") @db.VarChar(512)
  iosUrl          String?  @map("ios_url") @db.VarChar(512)
  instructions    String?  @db.VarChar(4000)
  isActive        Boolean  @default(false) @map("is_active")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User @relation("ExternalExamAppCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy User @relation("ExternalExamAppUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@map("external_exam_applications")
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  /// Stored lower-case (CHECK) so uniqueness is case-insensitive.
  email        String     @unique @db.VarChar(254)
  displayName  String     @map("display_name") @db.VarChar(120)
  /// Argon2id hash (Phase 3). Null = cannot sign in with a password.
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                        UserRole[]
  importJobs                   ImportJob[]                   @relation("ImportJobCreatedBy")
  importJobsCommitted          ImportJob[]                   @relation("ImportJobCommittedBy")
  activationCodesIssued        StudentActivationCode[]
  profileRequestsReviewed      StudentProfileChangeRequest[]
  historicalDocumentsUploaded  HistoricalDocument[]          @relation("HistoricalDocumentUploadedBy")
  historicalDocumentsPublished HistoricalDocument[]          @relation("HistoricalDocumentPublishedBy")
  historicalDocumentsWithdrawn HistoricalDocument[]          @relation("HistoricalDocumentWithdrawnBy")
  historicalDocumentsReviewed  HistoricalDocument[]          @relation("HistoricalDocumentReviewedBy")
  curriculaActivated           ProgramCurriculum[]           @relation("CurriculumActivatedBy")
  curriculaArchived            ProgramCurriculum[]           @relation("CurriculumArchivedBy")
  examAppsCreated              ExternalExamApplication[]     @relation("ExternalExamAppCreatedBy")
  examAppsUpdated              ExternalExamApplication[]     @relation("ExternalExamAppUpdatedBy")
  reExamFeeRulesCreated        ReExamFeeRule[]               @relation("ReExamFeeRuleCreatedBy")
  reExamFeeRulesActivated      ReExamFeeRule[]               @relation("ReExamFeeRuleActivatedBy")
  reExamFeeRulesRetired        ReExamFeeRule[]               @relation("ReExamFeeRuleRetiredBy")
  reExamApplicationsDecided    ReExamApplication[]           @relation("ReExamApplicationDecidedBy")
  paymentDestinationsCreated   ReExamPaymentDestination[]    @relation("PaymentDestinationCreatedBy")
  paymentDestinationsUpdated   ReExamPaymentDestination[]    @relation("PaymentDestinationUpdatedBy")
  paymentDestinationsApproved  ReExamPaymentDestination[]    @relation("PaymentDestinationApprovedBy")
  paymentDestinationsRetired   ReExamPaymentDestination[]    @relation("PaymentDestinationRetiredBy")
  reExamPaymentsReviewed       ReExamPayment[]               @relation("ReExamPaymentReviewedBy")
  auditLogs                    AuditLog[]
  certificatesGenerated        Certificate[]                 @relation("CertificateGeneratedBy")
  certificatesApproved         Certificate[]                 @relation("CertificateApprovedBy")
  certificatesIssued           Certificate[]                 @relation("CertificateIssuedBy")
  certificatesRevoked          Certificate[]                 @relation("CertificateRevokedBy")

  @@map("users")
}

/// Roles are records, not an enum, so new roles need no migration.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(64)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================================================
// Logs (append-only)
// ============================================================================================

/// Append-only audit trail (UPDATE and DELETE are rejected by a trigger).
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(100)
  entityType    String   @map("entity_type") @db.VarChar(64)
  entityId      String?  @map("entity_id") @db.VarChar(128)
  metadata      Json?
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Public verification attempts. Stores hashes, never raw lookup values or IPs.
/// UPDATE is rejected (trigger); DELETE stays possible for a future retention policy.
model VerificationLog {
  id                    String              @id @default(uuid(7)) @db.Uuid
  type                  VerificationType
  /// Keyed hash (HMAC) of the normalised identifier that was looked up.
  referenceHash         String?             @map("reference_hash") @db.VarChar(128)
  certificateId         String?             @map("certificate_id") @db.Uuid
  resultId              String?             @map("result_id") @db.Uuid
  studentRegistrationId String?             @map("student_registration_id") @db.Uuid
  outcome               VerificationOutcome
  clientIpHash          String?             @map("client_ip_hash") @db.VarChar(128)
  userAgent             String?             @map("user_agent") @db.VarChar(512)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  certificate         Certificate?         @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  result              Result?              @relation(fields: [resultId], references: [id], onDelete: Restrict)
  studentRegistration StudentRegistration? @relation(fields: [studentRegistrationId], references: [id], onDelete: Restrict)

  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([certificateId])
  @@index([resultId])
  @@index([studentRegistrationId])
  @@map("verification_logs")
}

// ============================================================================================
// Legacy migration support
// ============================================================================================

/// Maps an identifier from a legacy system (e.g. the WordPress tables, old certificate numbers or
/// QR tokens) to the record that replaced it. Used later for data migration and for keeping printed
/// legacy QR URLs resolvable. No data is imported in Phase 2.
model LegacyMapping {
  id               String   @id @default(uuid(7)) @db.Uuid
  sourceSystem     String   @map("source_system") @db.VarChar(32)
  sourceEntity     String   @map("source_entity") @db.VarChar(64)
  sourceIdentifier String   @map("source_identifier") @db.VarChar(255)
  targetEntity     String   @map("target_entity") @db.VarChar(64)
  targetId         String   @map("target_id") @db.Uuid
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([sourceSystem, sourceEntity, sourceIdentifier])
  @@index([targetEntity, targetId])
  @@map("legacy_mappings")
}

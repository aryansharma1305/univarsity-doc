{
  "extends": "@docversity/config/typescript/nextjs.json",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src",
    "test",
    "e2e",
    "e2e-staging",
    "*.config.ts"
  ],
  "exclude": ["node_modules"]
}

{
  "name": "@docversity/api",
  "version": "0.0.0",
  "private": true,
  "description": "Docversity REST API (NestJS).",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "admin:create": "node dist/cli/create-admin.js",
    "documents:backfill-student-copies": "node dist/cli/backfill-student-copies.js"
  },
  "dependencies": {
    "@docversity/database": "workspace:*",
    "@docversity/imports": "workspace:*",
    "@docversity/storage": "workspace:*",
    "@docversity/types": "workspace:*",
    "@docversity/validation": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "2.2.1",
    "bullmq": "6.3.11",
    "cookie": "2.0.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "multer": "2.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@docversity/config": "workspace:*",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}

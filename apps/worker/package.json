{
  "name": "@docversity/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Docversity background worker (BullMQ).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/main.ts",
    "start": "node dist/main.js",
    "queue:check": "node --disable-warning=ExperimentalWarning src/scripts/enqueue-health-test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@docversity/database": "workspace:*",
    "@docversity/imports": "workspace:*",
    "@docversity/storage": "workspace:*",
    "@docversity/types": "workspace:*",
    "@docversity/validation": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@docversity/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
